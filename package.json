{
  "name": "ekyc-backend-master-repository",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/shared",
    "ekyc-backend-master"
  ],
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "build": "node --check ekyc-backend-master/src/server.js",
    "start": "npm run start -w @ekyc/master",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "supertest": "7.3.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
